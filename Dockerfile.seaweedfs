# Build patched SeaweedFS from official upstream + Gisul admin patches.
ARG SEAWEEDFS_REF=4.39

FROM golang:1.25-alpine AS builder
ARG SEAWEEDFS_REF
RUN apk add --no-cache git
WORKDIR /src
RUN git clone --depth 1 --branch "${SEAWEEDFS_REF}" https://github.com/seaweedfs/seaweedfs.git .
COPY patches/admin.js weed/admin/static/js/admin.js
COPY patches/file_browser_handlers.go weed/admin/handlers/file_browser_handlers.go
# Inject only chunked-upload routes into upstream admin_handlers.go (do not replace the whole file).
RUN awk '{
  print
  if ($0 ~ /filesApi\.Handle\("\/upload", wrapWrite\(h\.fileBrowserHandlers\.UploadFile\)\)\.Methods\(http\.MethodPost\)/) {
    print "\tfilesApi.Handle(\"/upload-init\", wrapWrite(h.fileBrowserHandlers.InitChunkedUpload)).Methods(http.MethodPost)"
    print "\tfilesApi.Handle(\"/upload-chunk\", wrapWrite(h.fileBrowserHandlers.UploadChunk)).Methods(http.MethodPost)"
    print "\tfilesApi.Handle(\"/upload-complete\", wrapWrite(h.fileBrowserHandlers.CompleteChunkedUpload)).Methods(http.MethodPost)"
    print "\tfilesApi.Handle(\"/upload-abort\", wrapWrite(h.fileBrowserHandlers.AbortChunkedUpload)).Methods(http.MethodPost)"
  }
}' weed/admin/handlers/admin_handlers.go > /tmp/admin_handlers.go \
 && mv /tmp/admin_handlers.go weed/admin/handlers/admin_handlers.go \
 && grep -n 'upload-init\|upload-chunk\|upload-complete\|upload-abort' weed/admin/handlers/admin_handlers.go
RUN cd weed/admin && go generate .
RUN cd weed && CGO_ENABLED=0 go build -o /go/bin/weed .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates curl su-exec fuse && \
    addgroup -g 1000 seaweed && \
    adduser -D -u 1000 -G seaweed seaweed
COPY --from=builder /go/bin/weed /usr/bin/weed
COPY --from=builder /src/docker/entrypoint.sh /entrypoint.sh
RUN chmod 755 /entrypoint.sh /usr/bin/weed && \
    mkdir -p /data /etc/seaweedfs && \
    chown -R seaweed:seaweed /data /etc/seaweedfs
WORKDIR /data
ENTRYPOINT ["/entrypoint.sh"]
CMD ["mini", "-dir=/data"]
